# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nextjs_saas
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Next.js Application Port
NEXTJS_PORT=3000

# Database Connection URL (for Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextjs_saas

# Better Auth Configuration
# Generate a secret using: npx @better-auth/cli secret
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Resend Configuration (for OTP emails)
RESEND_API_KEY=your-api-key-here

RESEND_FROM_EMAIL=noreply@example.com

# Optional: GitHub Token for Semantic Release (if needed for private repos or advanced features)
# GITHUB_TOKEN=your_github_token_here

# Optional: NPM Token for Semantic Release (if publishing to a private NPM registry)
# NPM_TOKEN=your_npm_token_here
