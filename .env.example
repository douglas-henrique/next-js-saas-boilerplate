# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nextjs_saas
POSTGRES_PORT=5432

# Next.js Configuration
NEXTJS_PORT=3000

# Database URL (used by ORMs like Prisma, Drizzle, etc)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nextjs_saas

# GitHub Token (for semantic-release - optional, uses GITHUB_TOKEN from Actions by default)
# GITHUB_TOKEN=your_github_token_here

# NPM Token (for publishing packages - optional, only needed if publishing to npm)
# NPM_TOKEN=your_npm_token_here
