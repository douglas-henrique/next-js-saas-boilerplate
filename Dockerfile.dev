# Dockerfile para desenvolvimento Next.js
FROM node:22-alpine

# Instalar dependências do sistema necessárias para binários nativos
RUN apk add --no-cache libc6-compat python3 make g++

WORKDIR /app

# Copiar arquivos de dependências primeiro (para cache do Docker)
COPY package.json package-lock.json* ./

# Instalar dependências e garantir que lightningcss seja compilado corretamente
RUN npm ci || npm install && \
    npm rebuild lightningcss || true

# Copiar o resto do código
COPY . .

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED 1

# Script que:
# 1. Verifica e instala dependências se necessário (usa npm install se npm ci falhar)
# 2. Reinstala lightningcss para garantir binários nativos corretos (com dependências de build)
# 3. Gera o Prisma Client (sempre, para garantir que está atualizado)
# 4. Aplica as mudanças do schema no banco (db push) - falha silenciosamente se já existir
# 5. Inicia o servidor de desenvolvimento
CMD ["sh", "-c", "if [ ! -d 'node_modules' ] || [ 'package.json' -nt 'node_modules' ]; then npm ci || npm install; npm rebuild lightningcss || true; fi && npm run db:generate && (npm run db:push 2>/dev/null || true) && npm run dev"]
