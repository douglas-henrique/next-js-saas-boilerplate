# Dockerfile para desenvolvimento Next.js
FROM node:22-alpine

# Instalar dependências do sistema
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copiar arquivos de dependências primeiro (para cache do Docker)
COPY package.json package-lock.json* ./

# Instalar dependências (será executado novamente no CMD se necessário)
RUN npm ci || npm install

# Copiar o resto do código
COPY . .

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED 1

# Script que verifica se node_modules existe e instala dependências se necessário
CMD ["sh", "-c", "if [ ! -d 'node_modules' ] || [ 'package.json' -nt 'node_modules' ]; then npm ci; fi && npm run dev"]

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copiar arquivos de dependências
COPY package.json package-lock.json* ./

# Instalar dependências
RUN npm ci

# Copiar o resto do código
COPY . .

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED 1

# Script para verificar e instalar dependências antes de iniciar
CMD ["sh", "-c", "npm ci && npm run dev"]
